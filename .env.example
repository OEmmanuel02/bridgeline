DATABASE_URL=postgresql://bridgeline:replace-this-password@localhost:5432/bridgeline?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters-before-running
PORT=4000
# Set to the exact number of trusted platform proxies in production; keep 0 locally.
TRUST_PROXY_HOPS=0
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=14
PUBLIC_SUBMISSIONS_ENABLED=false
PUBLIC_REGISTRATION_ENABLED=false
PRIVACY_NOTICE_VERSION=draft-1
VITE_API_BASE_URL=/api/v1
VITE_SITE_URL=
VITE_PUBLIC_SUBMISSIONS_ENABLED=false
VITE_PUBLIC_REGISTRATION_ENABLED=false
# Set only for the one-time administrator provisioning command.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
